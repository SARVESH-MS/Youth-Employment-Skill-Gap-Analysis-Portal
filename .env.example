# ============================================================================
#  Youth Employment Skill Gap Analysis Portal — environment variables
#  Copy to `server/.env` (backend) before running.
# ============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# --- Database (single MongoDB) ----------------------------------------------
# Local service:  mongodb://127.0.0.1:27017/youth_employment_sgap
# Atlas example:  mongodb+srv://<user>:<pass>@<cluster>/youth_employment_sgap
MONGODB_URI=mongodb://127.0.0.1:27017/youth_employment_sgap

# --- Authentication ----------------------------------------------------------
# Generate strong secrets:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d
SESSION_IDLE_TIMEOUT_MINUTES=30
BCRYPT_SALT_ROUNDS=12
GOOGLE_CLIENT_ID=

# --- Security ----------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX_REQUESTS=20
CSRF_SECRET=replace-with-a-long-random-csrf-secret

# --- Initial super admin (bootstrap, production-safe: no hardcoded prod creds)
INITIAL_ADMIN_EMAIL=super.admin@yesgap.local
INITIAL_ADMIN_USERNAME=superadmin
INITIAL_ADMIN_PHONE=9000000001
INITIAL_ADMIN_PASSWORD=ChangeMe!SuperAdmin#2026
INITIAL_ADMIN_FULL_NAME=Platform Super Administrator

# --- File storage (GridFS inside MongoDB) ------------------------------------
RESUME_MAX_FILE_SIZE_MB=5
RESUME_ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# --- Code execution sandbox --------------------------------------------------
EXECUTION_ENABLED=false
EXECUTION_SERVICE_URL=
EXECUTION_SERVICE_TOKEN=
EXECUTION_TIMEOUT_MS=5000
EXECUTION_CPU_LIMIT_SECONDS=5
EXECUTION_MEMORY_LIMIT_MB=256
EXECUTION_MAX_OUTPUT_CHARS=20000
EXECUTION_TEMP_DIR=./.sandbox

# --- Standalone compiler (self-hosted Piston API) ---------------------------
COMPILER_SERVICE_URL=
COMPILER_SERVICE_TOKEN=
COMPILER_TIMEOUT_MS=15000
COMPILER_MAX_SOURCE_CHARS=60000
COMPILER_MAX_INPUT_CHARS=10000
COMPILER_MAX_OUTPUT_CHARS=20000

# --- Gemini AI assistant ------------------------------------------------------
# Create a Gemini API key in Google AI Studio. Keep this value in server/.env
# or your server's secret manager; never put it in client/.env or frontend code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Demo seed (development only; set false in production) ------------------
SEED_DEMO_DATA=true
SEED_STUDENT_COUNT=60
SEED_COMPANY_COUNT=100
SEED_ADMIN_COUNT=4
SEED_DEMO_PASSWORD=Demo@12345
