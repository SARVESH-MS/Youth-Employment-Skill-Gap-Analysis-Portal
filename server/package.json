{
  "name": "yesgap-server",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "description": "Backend API for the Youth Employment Skill Gap Analysis Portal",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed/index.js",
    "seed:fresh": "node src/seed/index.js --fresh",
    "seed:catalog": "node src/seed/index.js --catalog-only",
    "seed:references": "node src/seed/sync-curriculum-references.js",
    "seed:curriculum": "node src/seed/sync-curriculum-content.js",
    "db:migrate:atlas": "node scripts/migrate-local-to-atlas.js",
    "readiness:test-tools": "node scripts/readiness-test-tools.js",
    "test:readiness-demand": "node --test test/marketDemand.service.test.js",
    "test": "node --test"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  },
  "engines": {
    "node": ">=22"
  }
}
